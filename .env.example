# Example environment variables for Aivar
# Copy to .env and fill with real secrets or export in your shell.

GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=

# Runtime policy: PROD uses Groq and configured database storage;
# DEV uses Groq and JSON storage; MOCK skips AI and uses JSON storage.
ENVIRONMENT=MOCK

GROQ_MODEL=openai/gpt-oss-120b

# PROD database configuration. Required when ENVIRONMENT=PROD.
# AIVAR_DATABASE_URL=sqlite:///C:/path/to/aivar.db